# Copy to .env.local. Local Supabase values come from `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Portfolios are served at {slug}.{ROOT_DOMAIN}. Locally, *.localhost resolves
# to your machine, so jane.localhost:3000 works without editing /etc/hosts.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# live | record | replay. Tests always use replay. Production must be live.
AI_MODE=live
